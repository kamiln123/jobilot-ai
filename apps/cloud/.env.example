# Publiczne zmienne wykorzystywane tylko przez aplikację Cloud.
# Wklej wartości z Supabase do pliku .env.local obok tego pliku.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Gateway Cloud — zmienne serwerowe, bez prefiksu NEXT_PUBLIC_.
# W MVP stosujemy Gemini wyłącznie jako darmowego dostawcę wdrożeniowego.
# Nie wpisuj prawdziwego klucza do tego pliku ani do repozytorium.
AI_GLOBAL_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_DAILY_LIMIT=10
