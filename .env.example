# Skopiuj ten plik jako .env.local i wpisz WŁASNE wartości.
# Nigdy nie wpisuj prawdziwych kluczy do .env.example ani nie commituj .env.local.

# Cloud Mode — adres projektu Supabase (wartość publiczna, potrzebna klientowi).
NEXT_PUBLIC_SUPABASE_URL=

# Cloud Mode — klucz anon/publishable Supabase (wartość publiczna, potrzebna klientowi).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tylko backend / endpointy serwerowe. Nigdy nie dodawaj tego klucza z prefiksem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Tylko AI Gateway po stronie serwera. Opcjonalny w MVP, wymagany dla funkcji OpenAI.
OPENAI_API_KEY=

# Tylko AI Gateway po stronie serwera. Opcjonalny; przeznaczony dla przyszłego AI Job Discovery.
GEMINI_API_KEY=

# Opcjonalne limity serwerowe AI. Nie przechowują sekretów.
AI_GLOBAL_ENABLED=false
AI_DAILY_OPERATION_LIMIT=10
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARACTERS=20000
